# Normalise line endings: everything in the repo is stored as LF.
* text=auto eol=lf

# Shell scripts MUST be LF, or Linux reports "bad interpreter".
*.sh text eol=lf
*.py text eol=lf

# Windows batch files need CRLF.
*.cmd text eol=crlf

# Leave binaries alone.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
