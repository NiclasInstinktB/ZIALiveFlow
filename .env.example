# Example configuration. Copy to .env and adjust. Never commit secrets.
#
# Most of these are also editable in the admin backend under Settings, which stores
# them in backend/data/runtime_settings.json and wins over this file. Keep in .env
# only what has to exist before the app starts: the secrets below, and the bootstrap
# values for the very first run.
#
# Point APP_ENV_FILE at another path to use a different file, or set it to empty to
# ignore env files entirely and configure purely through real environment variables.

# Environment: dev | prod. prod requires JWT_SECRET to be set and warns on an
# insecure cookie configuration. Use dev for local work.
APP_ENV=dev

# ── Secrets. Environment only, never writable over HTTP ─────────────
# Required in prod. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Fernet key (base64, 32 bytes) encrypting stored secrets such as the directory bind
# password. Empty derives it from JWT_SECRET. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# ── First admin account, created on first start only ────────────────
# Applies while no account exists yet. Leaving the password empty makes the app
# generate a random one and write it to the log exactly once.
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_STORE_PATH=backend/data/admins.json

# ── Break-glass accounts ────────────────────────────────────────────
# Accounts that always hold every permission, regardless of group membership, and
# that the UI cannot strip. Permissions otherwise come only from groups, and nobody
# can grant a permission they do not hold themselves. Without this escape hatch you
# can lock yourself out, for example by deleting the last group holding "accounts".
# Comma separated usernames. Applies to local and directory accounts alike.
SUPERADMIN_USERS=
# Optional: members of this directory group (CN) are treated the same way.
SUPERADMIN_AD_GROUP=

# ── Web server ──────────────────────────────────────────────────────
# Also editable in the admin backend. Changing them there takes effect on the next
# restart, and only when started through serve.py, which reads the stored values
# before binding. Behind a reverse proxy, bind to localhost only.
APP_HOST=127.0.0.1
APP_PORT=8001
# Only relevant when the frontend runs separately during development. A production
# install serves UI and API from one origin and needs no entry here.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
LOG_FORMAT=console

# ── Session ─────────────────────────────────────────────────────────
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
SESSION_COOKIE_NAME=zlf_session
# Must be true behind HTTPS. Set it to false for plain http on localhost, otherwise
# the browser discards the cookie and every sign-in appears to fail.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ── Login throttle ──────────────────────────────────────────────────
# Deliberately generous: a short rolling block (HTTP 429) starts only after this many
# failures for the same IP and username within the window. A success clears the
# counter at once. State is kept in memory only.
LOGIN_MAX_FAILURES=20
LOGIN_WINDOW_MINUTES=5

# ── NSS feed ingest (TCP) ───────────────────────────────────────────
# INGEST_BIND_HOST has to be reachable from the NSS servers, so 127.0.0.1 will not
# work. Open ports 5140/5141/5142 in the firewall for the NSS server addresses only.
# Port 0 turns a feed off entirely, for example INGEST_DNS_PORT=0 for no DNS feed.
INGEST_ENABLED=true
INGEST_BIND_HOST=0.0.0.0
INGEST_WEB_PORT=5140
INGEST_FW_PORT=5141
INGEST_DNS_PORT=5142

# Dead connection detection on the feed connections. A TCP connection can die
# quietly (a firewall or NAT idle timeout, a blocked kernel): both sides still
# consider it healthy, nothing just flows any more. Keepalive lets the kernel prod
# the other side; the idle timeout drops a silent connection from this side, after
# which the NSS server reconnects. 0 turns the idle timeout off.
INGEST_TCP_KEEPALIVE=true
INGEST_KEEPALIVE_IDLE_SECONDS=60
INGEST_KEEPALIVE_INTERVAL_SECONDS=10
INGEST_KEEPALIVE_COUNT=3
INGEST_IDLE_TIMEOUT_SECONDS=600
# When the live view marks a feed as silent. Display only.
FEED_STALE_AFTER_SECONDS=120
# Application level allowlist, in addition to the firewall. Only these addresses may
# deliver feeds. Comma separated, single IPs or CIDR ranges. Empty allows all.
#   INGEST_ALLOWED_IPS=192.0.2.10, 192.0.2.11, 198.51.100.0/24
INGEST_ALLOWED_IPS=
# Time zone of the feeds, as an IANA name. This must match the Time Zone configured
# for the feeds in the Zscaler console. The web feed sends %s{time} as local time
# with no offset, so a wrong value here shifts every web timestamp silently. The
# firewall and DNS feeds send epoch milliseconds and are unaffected.
FEED_TIMEZONE=UTC

# ── Buffer and retention ────────────────────────────────────────────
# How long matches stay in memory (minutes, 1 to 60). Only matches are kept, and
# nothing is written to disk.
RETENTION_MINUTES=30
BUFFER_MAX_RECORDS=200000

# ── Interface defaults ──────────────────────────────────────────────
# Name shown in the header and the browser tab.
APP_NAME=ZIA Live-Flow
# Language for visitors who have not chosen one.
# en, de, fr, es, it, pt, nl, ja, zh
DEFAULT_LANGUAGE=en
# Appended to a user filter that contains no "@", turning "first.last" into
# "first.last@example.com". Empty appends nothing.
USER_DOMAIN_SUFFIX=@example.com
# Link to the source code, shown in the interface. The AGPL expects users who
# interact with the app over a network to be able to obtain the source.
SOURCE_URL=https://github.com/NiclasInstinktB/ZIALiveFlow

# ── Audit log ───────────────────────────────────────────────────────
# Records sign-ins and searches as metadata only, never log payloads.
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=30

# ── Self update ─────────────────────────────────────────────────────
# Branch the updater pulls from.
UPDATE_BRANCH=main

# ── Directory login (AD/LDAP), optional ─────────────────────────────
# Maintain this in the admin backend under AD/LDAP instead: changes apply at runtime
# and the bind password is stored encrypted. The values here are only a bootstrap for
# the first start, while nothing is saved in the backend yet.
#
# This is an additional login path next to the local accounts, active as soon as
# server, domain and base DN are set. Local accounts always keep working, including
# during a directory outage. A directory user is created as an account automatically
# on first sign-in, with no local password, and their permissions come from their
# groups.
#
# One or more servers, comma separated, up to four. The first is primary, the rest
# are failover targets. Each entry may carry its own scheme:
#   ldap://  ldaps://  gc://  gcs://      (gc is the global catalog, forest wide)
#   LDAP_SERVER=dc01.example.com
#   LDAP_SERVER=gc://dc01.example.com, gc://dc02.example.com
LDAP_SERVER=
LDAP_PORT=0                      # 0 picks the default per scheme: 389/636, GC 3268/3269
LDAP_USE_SSL=true
LDAP_DOMAIN=example.com          # UPN domain, so the bind is user@LDAP_DOMAIN
LDAP_BASE_DN=DC=example,DC=com   # search base for the group lookup
# Optional service account for the group search. Without it the user binds directly.
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
LDAP_GROUP_ATTR=memberOf
LDAP_CONNECT_TIMEOUT_SECONDS=5
# The group to permission mapping is not configured here. It is set interactively in
# the admin backend under Accounts, and stored with the accounts.

# ── Single sign-on (OpenID Connect), optional ───────────────────────
# Maintain this in the admin backend under AD/LDAP, SSO. The values here are only a
# bootstrap for the first start.
#
# An additional login path using the authorization code flow with PKCE, for example
# against Microsoft Entra ID. It is additive and off by default, so local accounts
# and the directory password login are unaffected. Active only when OIDC_ENABLED is
# true and issuer, client id and client secret are all set.
#
# The identity comes from the ID token. Group membership is loaded live from the
# directory, exactly as in the password login, and mapped to permissions through the
# same group mapping. A sign-in without a matching group gets no access.
OIDC_ENABLED=false
# Issuer URL, used as the discovery base.
# Entra: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Redirect URI, which must also be registered with the identity provider. Empty
# derives it from the request as origin + /api/auth/sso/callback. Set it explicitly
# behind a reverse proxy, where the derived scheme or host can be wrong:
#   OIDC_REDIRECT_URL=https://liveflow.example.com/api/auth/sso/callback
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid profile email
